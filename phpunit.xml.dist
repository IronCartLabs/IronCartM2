<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit suite for `composer test` and the CI `unit` job (#214). CI runs
  this exact file, so local and CI scope stay identical.

  The suite is the whole of Test/Unit. New tests are picked up
  automatically. The last <exclude> entries were removed in #225. Do not
  add one without filing an issue that removes it: an excluded test runs
  nowhere.
-->
<phpunit
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
  bootstrap="Test/Unit/bootstrap.php"
  cacheResult="false"
  colors="true">
  <testsuites>
    <testsuite name="unit">
      <directory>Test/Unit</directory>
    </testsuite>
  </testsuites>
</phpunit>
