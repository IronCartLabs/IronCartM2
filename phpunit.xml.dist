<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit suite for `composer test` and the CI `unit` job (#214). CI runs
  this exact file, so local and CI scope stay identical.

  The suite is the whole of Test/Unit. New tests are picked up
  automatically. The <exclude> entries below are the files that failed
  the first time the full suite ran in CI (PR #215, identical on PHP
  8.1-8.4). Each one links to the issue that removes it. Do not add to
  this list without filing an issue: an excluded test runs nowhere.
-->
<phpunit
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
  bootstrap="vendor/autoload.php"
  cacheResult="false"
  colors="true">
  <testsuites>
    <testsuite name="unit">
      <directory>Test/Unit</directory>

      <!-- #216: Magento types (magento/framework, module-store/user/cron,
           generated factories, psr/log) are not on the unit-job classpath.
           FilesystemSandbox extends DirectoryList, so every sandbox user
           lands here. -->
      <exclude>Test/Unit/Check/Admin/AdminUrlFrontnameCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Admin/AdminUserInventoryCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Admin/TwoFactorCoverageCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Admin/WeakPasswordIndicatorCheckTest.php</exclude>
      <exclude>Test/Unit/Check/AdminAudit/RecentActionsCheckTest.php</exclude>
      <exclude>Test/Unit/Check/CodeSmell/DynamicIncludeCheckTest.php</exclude>
      <exclude>Test/Unit/Check/CodeSmell/EvalCheckTest.php</exclude>
      <exclude>Test/Unit/Check/CodeSmell/PregReplaceEvalModifierCheckTest.php</exclude>
      <exclude>Test/Unit/Check/CodeSmell/ShellExecCheckTest.php</exclude>
      <exclude>Test/Unit/Check/CodeSmell/UnserializeUntrustedCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Cve/ComposerCveCheckTest.php</exclude>
      <exclude>Test/Unit/Check/FileIntegrity/ComposerLockIntegrityCheckTest.php</exclude>
      <exclude>Test/Unit/Check/FileIntegrity/CoreFileIntegrityCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Filesystem/CryptKeyCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Filesystem/EnvPhpPermissionsCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Filesystem/StrayDevToolingCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Filesystem/WritableDirectoriesCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Hyva/AlpineCdnUsageCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Hyva/CheckoutCspRegressionCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Hyva/HyvaDetectorTest.php</exclude>
      <exclude>Test/Unit/Check/Hyva/HyvaModuleDriftCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Hyva/TailwindConfigExposureCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Integrity/EnvPhpIntegrityCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Integrity/FileHashCheckTest.php</exclude>
      <exclude>Test/Unit/Check/License/LicenseConfigTest.php</exclude>
      <exclude>Test/Unit/Check/License/UpgradeNagEmitterTest.php</exclude>
      <exclude>Test/Unit/Check/Operational/CronErrorRateCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Operational/CronLastRunCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Operational/IndexerStateCheckTest.php</exclude>
      <exclude>Test/Unit/Check/PatchLevel/MagentoVersionCheckTest.php</exclude>
      <exclude>Test/Unit/Check/PwaStudio/GraphQlCorsWildcardCheckTest.php</exclude>
      <exclude>Test/Unit/Check/PwaStudio/GraphQlIntrospectionCheckTest.php</exclude>
      <exclude>Test/Unit/Check/PwaStudio/GraphQlQueryComplexityCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/Csp/CspProbeRunnerTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/CspModeCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/HttpsEnforcementCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/MageModeCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/MagentoModeReaderTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/ProfilerCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/SecureCookieCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Upload/UploadConfigTest.php</exclude>
      <exclude>Test/Unit/Check/Upload/UploadPayloadBuilderLicenseTest.php</exclude>
      <exclude>Test/Unit/Check/Upload/UploadRunnerTest.php</exclude>
      <exclude>Test/Unit/Console/UploadFlagTest.php</exclude>
      <exclude>Test/Unit/Cron/DrainScanConsumerTest.php</exclude>
      <exclude>Test/Unit/Cron/UploadScanTest.php</exclude>
      <exclude>Test/Unit/Model/ScanEngineRunnerTest.php</exclude>

      <!-- #217 (and #216): CspCheckTestHelper calls the protected
           TestCase::createMock() from outside the TestCase. -->
      <exclude>Test/Unit/Check/Runtime/Csp/CspBaseUrlConfiguredCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/Csp/CspFrameAncestorsCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/Csp/CspMissingCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/Csp/CspReportEndpointCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/Csp/CspReportOnlyInProductionCheckTest.php</exclude>
      <exclude>Test/Unit/Check/Runtime/Csp/CspScriptSrcUnsafeCheckTest.php</exclude>

      <!-- #218: real assertion or logic failures (BaselineBuilderTest
           also needs #216). -->
      <exclude>Test/Unit/Check/Integrity/BaselineBuilderTest.php</exclude>
      <exclude>Test/Unit/Check/License/LicenseVerifierTest.php</exclude>
      <exclude>Test/Unit/Check/PatchLevel/ComposerAdvisoryCheckTest.php</exclude>
    </testsuite>
  </testsuites>
</phpunit>
